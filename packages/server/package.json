{
  "name": "@jobber/server",
  "version": "1.0.0",
  "description": "Jobber, a wanna-be lambda",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build:image": "docker build -t jobber ./",
    "build": "rimraf ./dist/* && tsc && tsc-alias -p tsconfig.json",
    "start": "node ./dist/index.js",
    "dev": "pnpm build && node --env-file-if-exists=.env ./dist/index.js",
    "drizzle:migrate": "pnpm build && pnpm drizzle-kit migrate",
    "drizzle:generate": "pnpm build && pnpm drizzle-kit generate"
  },
  "keywords": [],
  "author": "Eithan Hersey-Tuit",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@jobber/tcp-frame-socket": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cron": "^3.5.0",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.13.13",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "drizzle-kit": "^0.30.6",
    "rimraf": "^5.0.10",
    "tsc-alias": "^1.9.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
